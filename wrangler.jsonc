{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kola",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kola-db",
      "database_id": "9d7a2abc-a05d-4573-8344-c1c380f5b6dd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kola-media"
    }
  ]
}
